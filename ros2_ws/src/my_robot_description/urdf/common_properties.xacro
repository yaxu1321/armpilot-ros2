<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>


    <!-- 材质 -->
    <material name="light_green">
        <color rgba="0.4 1.0 0.4 1.0"/>
    </material>

    <material name="dark_green">
        <color rgba="0.0 0.4 0.0 1.0"/>
    </material>

</robot>